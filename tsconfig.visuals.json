{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/visual-contracts.js",
    "src/audio-math.js",
    "src/audio-pipeline.js",
    "src/mode-registry.js",
    "src/mode-runtime.js",
    "src/visuals/*.js",
    "__tests__/types/*.cjs",
    "types/visual-globals.d.ts"
  ],
  "exclude": ["src/visuals/loop.js"]
}
