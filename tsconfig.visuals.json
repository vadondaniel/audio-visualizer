{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/visual-contracts.js",
    "src/audio-math.js",
    "src/audio-pipeline.js",
    "src/mode-registry.js",
    "src/mode-runtime.js",
    "src/settings-actions.js",
    "src/settings-ui.js",
    "src/settings-view.js",
    "src/settings-panel.js",
    "src/settings-protocol.js",
    "src/settings-window.js",
    "src/settings-preload.js",
    "src/settings-client.js",
    "src/mini-overlay-ui.js",
    "src/tray-controls.js",
    "src/renderer-entry.js",
    "src/mini-overlay.js",
    "src/tray-controller.js",
    "src/mini-overlay-math.js",
    "src/overlay-display.js",
    "src/preload.js",
    "src/visuals/*.js",
    "__tests__/types/*.cjs",
    "types/visual-globals.d.ts"
  ],
  "exclude": ["src/visuals/loop.js"]
}
