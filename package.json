{
  "name": "audio-visualizer",
  "version": "1.0.1",
  "description": "Real-time system audio visualizer, NCS style",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ceavan.audiovisualizer",
    "productName": "Audio Visualizer",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc-channels.js",
      "index.html",
      "renderer.js"
    ]
  }
}