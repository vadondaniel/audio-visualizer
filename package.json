{
  "name": "audio-visualizer",
  "version": "1.2.9",
  "description": "Real-time system audio visualizer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:audio": "jest --runInBand --runTestsByPath __tests__/audio.test.js __tests__/audio-math.test.js __tests__/audio-pipeline.test.js __tests__/bass-sensitivity.test.js",
    "test:visuals": "jest --runInBand --runTestsByPath __tests__/visual-modes.test.js __tests__/orbit.test.js __tests__/prism.test.js __tests__/trail-math.test.js __tests__/trail-rendering.test.js __tests__/mode-registry.test.js",
    "test:settings": "jest --runInBand --runTestsByPath __tests__/settings-actions.test.js __tests__/mode-list.test.js __tests__/media.test.js __tests__/window-state.test.js",
    "test:electron": "node scripts/verify.cjs electron",
    "check": "npm run check:types && npm run test:unit",
    "check:types": "tsc --project tsconfig.visuals.json",
    "format": "npm run format:js && npm run format:cs && npm run format:ps1",
    "format:js": "prettier --write .",
    "format:cs": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\format-cs.ps1",
    "format:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\format-ps1.ps1",
    "format:check": "npm run format:check:js && npm run format:check:cs",
    "format:check:js": "prettier --check .",
    "format:check:cs": "dotnet format media-watcher/media-watcher.csproj --verify-no-changes",
    "benchmark": "node scripts/verify.cjs benchmark",
    "benchmark:smoke": "node scripts/verify.cjs benchmark-smoke",
    "build:media-watcher": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-media-watcher.ps1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.ceavan.audiovisualizer",
    "productName": "Audio Visualizer",
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "media-watcher/publish/media-watcher.exe"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "src/icon.ico"
    },
    "files": [
      "src/**/*",
      "media-watcher/publish/media-watcher.exe"
    ]
  }
}
