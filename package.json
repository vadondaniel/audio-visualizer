{
  "name": "audio-visualizer",
  "version": "1.2.5",
  "description": "Real-time system audio visualizer, NCS style",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "electron benchmark.js"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.ceavan.audiovisualizer",
    "productName": "Audio Visualizer",
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "media-watcher.ps1"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc-channels.js",
      "window-state.js",
      "index.html",
      "style.css",
      "audio-math.js",
      "trail-math.js",
      "constants.js",
      "state.js",
      "dom.js",
      "background.js",
      "audio.js",
      "diagnostics.js",
      "wake-lock.js",
      "media-watcher.ps1",
      "visuals.js",
      "visuals/**/*",
      "media.js",
      "ui.js",
      "icon.png",
      "icon.ico"
    ]
  }
}
